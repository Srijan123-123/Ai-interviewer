AI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o-mini
# Optional. Defaults to the OpenAI Chat Completions API.
AI_API_URL=https://api.openai.com/v1/chat/completions
# Optional. Defaults to whisper-1 for OpenAI and whisper-large-v3-turbo for Groq.
# AI_TRANSCRIPTION_MODEL=whisper-1
# Optional. Derived from AI_API_URL when omitted.
# AI_TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
MONGO_URL=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Generate at least 32 random bytes; keep this secret stable across deployments.
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
